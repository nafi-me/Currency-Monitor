<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.livefx.Controller"
      spacing="12" padding="20">

    <HBox spacing="10">
        <ComboBox fx:id="fromCurrency" prefWidth="120"/>
        <Label text="→" style="-fx-font-size:22px; -fx-padding:4 8;"/>
        <ComboBox fx:id="toCurrency" prefWidth="120"/>
    </HBox>

    <Label fx:id="rateLabel" style="-fx-font-size:26px; -fx-font-weight:bold;"/>

    <Label fx:id="changeLabel" style="-fx-font-size:18px; -fx-text-fill:#444;"/>

    <LineChart fx:id="chart" prefHeight="350">
        <xAxis>
            <CategoryAxis label="Time"/>
        </xAxis>
        <yAxis>
            <NumberAxis label="Exchange Rate"/>
        </yAxis>
    </LineChart>

</VBox>
